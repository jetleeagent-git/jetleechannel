RewriteEngine On

# Case-insensitive canonical redirects — subpath-PRESERVING.
# NOTE: in .htaccess (per-directory) context RewriteRule patterns have NO leading
# slash, so match against REQUEST_URI in RewriteCond and reuse captures as %1/%2.
# The case-sensitive !^/canonical guard stops the canonical path self-redirecting,
# which is what previously swallowed /thecolletive/images/* etc.
RewriteCond %{REQUEST_URI} !^/amberwood(/|$)
RewriteCond %{REQUEST_URI} ^/(amberwood|amber-wood|amberwood-residences|amberwoodresidences)(/.*)?$ [NC]
RewriteRule ^ /amberwood%2 [R=301,L]

RewriteCond %{REQUEST_URI} !^/thecolletive(/|$)
RewriteCond %{REQUEST_URI} ^/(theColletive|thecollective|TheCollective|Thecolletive)(/.*)?$ [NC]
RewriteRule ^ /thecolletive%2 [R=301,L]

RewriteCond %{REQUEST_URI} !^/granddunman(/|$)
RewriteCond %{REQUEST_URI} ^/(grand-dunman|granddunman)(/.*)?$ [NC]
RewriteRule ^ /granddunman%2 [R=301,L]

RewriteCond %{REQUEST_URI} !^/lentorgardens(/|$)
RewriteCond %{REQUEST_URI} ^/(lentor-gardens|lentorgardens)(/.*)?$ [NC]
RewriteRule ^ /lentorgardens%2 [R=301,L]

RewriteCond %{REQUEST_URI} !^/TheSerra(/|$)
RewriteCond %{REQUEST_URI} ^/(thesierra|theserra)(/.*)?$ [NC]
RewriteRule ^ /TheSerra%2 [R=301,L]

# Force UTF-8 Encoding across all sites
AddDefaultCharset UTF-8
<FilesMatch "\.html?$">
    <IfModule mod_headers.c>
        Header set Content-Type "text/html; charset=UTF-8"
    </IfModule>
</FilesMatch>

# Enable Browser Caching & Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
