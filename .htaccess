RewriteEngine On

# Case-insensitive / spelling redirects for project folders
RewriteRule ^(?i)thecolletive/?(.*)$ /thecolletive/$1 [R=301,L]
RewriteRule ^(?i)thecollective/?(.*)$ /thecolletive/$1 [R=301,L]
RewriteRule ^(?i)belgraviaace/?(.*)$ /BelgraviaAce/$1 [R=301,L]
RewriteRule ^(?i)onemarinagardens/?(.*)$ /OneMarinaGardens/$1 [R=301,L]
RewriteRule ^(?i)sophiameadow/?(.*)$ /SophiaMeadow/$1 [R=301,L]
RewriteRule ^(?i)thehillshore/?(.*)$ /TheHillshore/$1 [R=301,L]
RewriteRule ^(?i)theorie/?(.*)$ /TheOrie/$1 [R=301,L]
RewriteRule ^(?i)theserra/?(.*)$ /TheSerra/$1 [R=301,L]
RewriteRule ^(?i)thesierra/?(.*)$ /TheSerra/$1 [R=301,L]

# Force UTF-8 Encoding across all sites
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
    Header set Content-Type "text/html; charset=UTF-8"
</IfModule>

# Enable Browser Caching & Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
