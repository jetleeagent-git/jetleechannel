RewriteEngine On

# Case-insensitive redirects to exact lowercase canonical paths
RewriteCond %{REQUEST_URI} !^/amberwood/
RewriteCond %{REQUEST_URI} ^/amberwood/? [NC]
RewriteRule ^ /amberwood/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/amber-wood/? [NC]
RewriteRule ^ /amberwood/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/amberwood-residences/? [NC]
RewriteRule ^ /amberwood/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/amberwoodresidences/? [NC]
RewriteRule ^ /amberwood/ [R=301,L]

# Prevent infinite rewrite loops: match specific non-canonical aliases only
RewriteCond %{REQUEST_URI} ^/theColletive/? [NC]
RewriteRule ^ /thecolletive/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/thecollective/? [NC]
RewriteRule ^ /thecolletive/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/TheCollective/? [NC]
RewriteRule ^ /thecolletive/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/grand-dunman/? [NC]
RewriteRule ^ /granddunman/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/lentor-gardens/? [NC]
RewriteRule ^ /lentorgardens/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/thesierra/? [NC]
RewriteRule ^ /TheSerra/ [R=301,L]

# Force UTF-8 Encoding across all sites
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
    Header set Content-Type "text/html; charset=UTF-8"
</IfModule>

# Enable Browser Caching & Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
