RewriteEngine On

# Hyphenated & casing redirects (using [NC] flag)
RewriteRule ^lentor-gardens/?(.*)$ /lentorgardens/$1 [NC,R=301,L]
RewriteRule ^grand-dunman/?(.*)$ /granddunman/$1 [NC,R=301,L]
RewriteRule ^thecolletive/?(.*)$ /thecolletive/$1 [NC,R=301,L]
RewriteRule ^thecollective/?(.*)$ /thecolletive/$1 [NC,R=301,L]
RewriteRule ^belgraviaace/?(.*)$ /BelgraviaAce/$1 [NC,R=301,L]
RewriteRule ^onemarinagardens/?(.*)$ /OneMarinaGardens/$1 [NC,R=301,L]
RewriteRule ^sophiameadow/?(.*)$ /SophiaMeadow/$1 [NC,R=301,L]
RewriteRule ^thehillshore/?(.*)$ /TheHillshore/$1 [NC,R=301,L]
RewriteRule ^theorie/?(.*)$ /TheOrie/$1 [NC,R=301,L]
RewriteRule ^theserra/?(.*)$ /TheSerra/$1 [NC,R=301,L]
RewriteRule ^thesierra/?(.*)$ /TheSerra/$1 [NC,R=301,L]

# Force UTF-8 Encoding across all sites
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
    Header set Content-Type "text/html; charset=UTF-8"
</IfModule>

# Enable Browser Caching & Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
