RewriteEngine On

# Case-insensitive canonical redirects — subpath-PRESERVING.
# The RewriteCond case-sensitive guard (no [NC]) prevents the canonical path from
# redirecting to itself, which previously swallowed /thecolletive/images/* etc.
RewriteCond %{REQUEST_URI} !^/amberwood(/|$)
RewriteRule ^/(amberwood|amber-wood|amberwood-residences|amberwoodresidences)(/.*)?$ /amberwood$2 [R=301,NC,L]

RewriteCond %{REQUEST_URI} !^/thecolletive(/|$)
RewriteRule ^/(theColletive|thecollective|TheCollective|Thecolletive|thecolletive)(/.*)?$ /thecolletive$2 [R=301,NC,L]

RewriteCond %{REQUEST_URI} !^/granddunman(/|$)
RewriteRule ^/(grand-dunman|granddunman)(/.*)?$ /granddunman$2 [R=301,NC,L]

RewriteCond %{REQUEST_URI} !^/lentorgardens(/|$)
RewriteRule ^/(lentor-gardens|lentorgardens)(/.*)?$ /lentorgardens$2 [R=301,NC,L]

RewriteCond %{REQUEST_URI} !^/TheSerra(/|$)
RewriteRule ^/(thesierra|TheSierra|theserra|Theserra|THESERRA)(/.*)?$ /TheSerra$2 [R=301,NC,L]

# Force UTF-8 Encoding across all sites
AddDefaultCharset UTF-8
<FilesMatch "\.html?$">
    <IfModule mod_headers.c>
        Header set Content-Type "text/html; charset=UTF-8"
    </IfModule>
</FilesMatch>

# Enable Browser Caching & Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
